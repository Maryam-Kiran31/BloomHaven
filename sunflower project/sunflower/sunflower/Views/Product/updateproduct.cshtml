@{
    Layout = null;
}
@model Addproduct;

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UpdateProducts</title>
    <link rel="stylesheet" href="~/css/stylehome.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="script.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/login.css">
</head>

<body>

    <div class="container-fluid designs">

        <main style="opacity: 0.8;">
            <div class="py-5  text-center">
                <h1 style="font-family: Quattrocento;" class=" fs-1 fw-bolder text-dark">Update Products</h1>
            </div>
            <div class="row text-light   ">
                <div class="col-md-7 mx-auto ">
                    <form class="bg-dark form-group" asp-action="Up" asp-controller="Product" method="post" enctype="multipart/form-data">
                        <div class="row g-3" style="font-family: Quattrocento;">

                            @* <div class="row    g-3" style="font-family: cursive;">
                                <div class="col-sm-6 mx-auto">
                                    <label for="id" class="form-label">Id </label>
                                    <input type="number" class="form-control" name="Id" />

                                </div>
                            </div> *@
                            <div class="row  g-3" style="font-family: cursive;">
                                <div class="col-sm-6 mx-auto">
                                    <label for="Name" class="form-label">Name </label>
                                    <input type="text" class="form-control" name="Name" />

                                </div>
                            </div>
                          
                            <div class="row  g-3" style="font-family: cursive;">

                                <div class="col-sm-6 mx-auto">
                                    <label for="p2" class="form-label">Qunatity</label>
                                    <input type="text" class="form-control" id="p0" placeholder="" name="Qunatity" value="">

                                </div>
                            </div>
                            <div class="row  g-3" style="font-family: cursive;">

                                <div class="col-sm-6 mx-auto">
                                    <label for="p3" class="form-label">Price</label>
                                    <input type="text" class="form-control" id="p0" placeholder="" name="Price" value="">

                                </div>
                            </div>

                           <div class="row  g-3" style="font-family: cursive;">

                                <div class="col-sm-6 mx-auto">
                                    <label asp-for="PathOfImage">Upload Image</label>
                                    <input asp-for="PathOfImage" class="form-control" type="file">
                                    <span asp-validation-for="PathOfImage" class="text-danger"></span>

                                </div>
                            </div>
                        </div>

                        <hr class="my-4 bg-light">

                        <div class="py-3">
                            <button class="w-25 ms-5 btn" style="font-family: Quattrocento; background-color: coral;" type="submit">
                                Submit
                            </button>
                        </div>
                    </form>

                </div>
                <form style="display:inline" class="d-flex justify-content-center" action="/Product/Admin" method="post">

                    <button type="submit" class="btn ms-3  btn-danger" onclick="location.href='@Url.Action("Admin","Product")'">
                        Back
                    </button>
                </form>
            </div>
    </div>


    <script src="/docs/5.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
            crossorigin="anonymous"></script>

    <script src="form-validation.js"></script>


    <span id="PING_IFRAME_FORM_DETECTION" style="display: none;"></span>
    <span id="PING_CONTENT_DLS_POPUP"
          style="display: none;"></span>
    <div style="background-color: transparent; border: none; bottom: 15px; display: block; margin: 0px; opacity: 1; padding: 0px; position: fixed; right: 15px; z-index: 2147483646;">
    </div>
</body>

</html>



