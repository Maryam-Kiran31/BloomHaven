<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>

<button id="sendButton">Press to Send Message</button>
<p id="messageDisplay"></p>

<script src="~/js/site.js"></script>
 
 <!-- AJAX and JavaScript -->
<script>
    $(document).ready(function () {
        $('#productSearch').click(function () {



            console.log("Search button clicked. Search term: ");  // Debugging
            var searchTerm = $('#txtData').val();  // Get the search term

            console.log("Search button clicked. Search term: " + searchTerm);  // Debugging

            $.ajax({
                url: "/Home/SearchResults",
                type: "GET",
                data: { Name: searchTerm },  // Pass search term to the backend
                success: function (response) {
                    console.log("Raw response: ", response);  // Debugging
                    let products = Array.isArray(response) ? response : [];

                    if (products.length === 0) {
                        $("#SearchResult").html("<div class='alert alert-warning'>No products found.</div>");
                        return;
                    }

                    let html = "<div class='row top' style='margin-top:80px'> ";
                    products.forEach(function (product) {
                        let imagePath = `${product.PathOfImage}`;
                        html += `
                                    <div class="col-12 col-md-4 mb-2">
                                        <div class="card">
                                                <img src="/uploadedfiles/${imagePath}" class="scale-with-grid wp-post-image img-fluid" alt="${product.Name}" loading="lazy">
                                            <div class="card-body">
                                                <h5 class="card-title">${product.Name}</h5>
                                                <a href="#" class="btn btn-success">${product.Price}</a>
                                                <div style="position: absolute; bottom: 10px; right: 15px; width: 40px; height: 40px; background-color: #FFBE33; border-radius: 50%; display: flex; justify-content: center; align-items: center;">
                                                    <i class="fas fa-shopping-cart" style="color: white; font-size: 23px;"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>`;
                    });
                    html += "</div>";
                    $("#SearchResult").html(html);
                },
                error: function (xhr, status, error) {
                    console.log("XHR: ", xhr);   // Debugging
                    console.log("Status: ", status);   // Debugging
                    console.log("Error: ", error);   // Debugging
                    $("#SearchResult").html("<div class='alert alert-danger'>Error: " + error + "</div>");
                }
            });
        });
    });
</script>
